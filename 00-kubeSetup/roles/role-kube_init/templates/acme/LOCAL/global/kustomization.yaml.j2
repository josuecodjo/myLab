---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
# No `namespace:` transformer here on purpose. Kustomize has no schema for the
# cert-manager CRDs, so it cannot tell that ClusterIssuer is cluster-scoped and
# would stamp a namespace onto it. The only namespaced resource in issuer.yaml
# (the homelab-ca Certificate) declares `namespace: cert-manager` itself.
resources:
  - issuer.yaml
